# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Ensure diffs have LF endings
*.diff text eol=lf
*.bat text eol=crlf
*.sh text eol=lf
tools/rules/laws/fixtures/**/*.cpp -text whitespace=cr-at-eol
tools/rules/laws/fixtures/closer-mixed-indent/*.cpp whitespace=cr-at-eol,-space-before-tab
tools/rules/laws/fixtures/closer-staged-argument/*.cpp whitespace=cr-at-eol,-space-before-tab

# Keep the zxcvbn word lists byte-identical to upstream so their digests hold
Telegram/Resources/zxcvbn/*.txt text eol=lf

# Ensure lottie animations are treated as binary files
*.lottie binary

# Ensure fonts are treated as binary files
*.ttf binary

# Ensure packed caches are treated as binary files
*.cache binary
# Raw float tables, such as the 3D diamond model data
*.bin binary
